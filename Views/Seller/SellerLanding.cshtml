@{
    Layout = "~/Views/Shared/_SellerLayout.cshtml";

    var totalProducts = ViewBag.TotalProducts ?? 0;
    var totalOrders = ViewBag.TotalOrders ?? 0;
    var revenue = ViewBag.Revenue ?? 0;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="space-y-6">

    <!-- 🔷 WELCOME -->
    <div class="bg-white p-6 rounded-xl shadow">
        <h2 class="text-xl font-bold text-blue-600">
            Welcome Back 👋
        </h2>
        <p class="text-gray-600 mt-2">
            Here’s your business overview today
        </p>
    </div>

    <!-- 🔷 STATS -->
    <div class="grid grid-cols-3 gap-6">

        <!-- PRODUCTS -->
        <div class="bg-blue-100 p-6 rounded-xl shadow hover:scale-105 transition">
            <h3 class="text-sm text-gray-600">Total Products</h3>
            <p class="text-2xl font-bold text-blue-700 mt-2">
                @totalProducts
            </p>
        </div>

        <!-- ORDERS -->
        <div class="bg-indigo-100 p-6 rounded-xl shadow hover:scale-105 transition">
            <h3 class="text-sm text-gray-600">Total Orders</h3>
            <p class="text-2xl font-bold text-indigo-700 mt-2">
                @totalOrders
            </p>
        </div>

        <!-- REVENUE -->
        <div class="bg-green-100 p-6 rounded-xl shadow hover:scale-105 transition">
            <h3 class="text-sm text-gray-600">Revenue</h3>
            <p class="text-2xl font-bold text-green-700 mt-2">
                ₹ @revenue
            </p>
        </div>

    </div>

</div>