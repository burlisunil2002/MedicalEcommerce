@model IEnumerable<VivekMedicalProducts.Models.ProductModel>

@{
    Layout = null;
}

<head>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<div class="min-h-screen bg-gradient-to-br from-indigo-900 via-slate-900 to-black p-6 text-white">

    <!-- HEADER -->
    <div class="max-w-7xl mx-auto mb-8 flex flex-wrap gap-4 justify-between items-center">

        <div>
            <h1 class="text-3xl font-bold tracking-wide">
                📦 Product Management
            </h1>
            <p class="text-sm text-gray-300">
                Manage all your products, variants & stock
            </p>
        </div>

        <a asp-action="AddProducts"
           class="px-6 py-3 bg-gradient-to-r from-pink-500 to-red-500 rounded-xl shadow-lg hover:scale-105 transition-all font-semibold">
            + Add Product
        </a>

    </div>

    <!-- GLASS CARD -->
    <div class="max-w-7xl mx-auto backdrop-blur-xl bg-white/10 border border-white/20 rounded-3xl shadow-2xl overflow-hidden">

        <div class="overflow-x-auto">

            <table class="w-full text-sm">

                <!-- HEADER -->
                <thead class="bg-white/10 text-gray-200 text-xs uppercase tracking-wider">
                    <tr>
                        <th class="px-6 py-4">Image</th>
                        <th class="px-6 py-4">Product</th>
                        <th class="px-6 py-4">Price</th>
                        <th class="px-6 py-4">Variants</th>
                        <th class="px-6 py-4">Stock</th>
                        <th class="px-6 py-4">GST</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4 text-center">Actions</th>
                    </tr>
                </thead>

                <!-- BODY -->
                <tbody class="divide-y divide-white/10">

                    @foreach (var item in Model)
                    {
                        var hasVariants = item.Variants?.Any() == true;

                        var minPrice = hasVariants ? item.Variants.Min(v => v.Price) : 0;
                        var maxPrice = hasVariants ? item.Variants.Max(v => v.Price) : 0;
                        var totalStock = hasVariants ? item.Variants.Sum(v => v.StockQuantity) : 0;

                        <tr class="hover:bg-white/10 transition duration-300">

                            <!-- IMAGE -->
                            <td class="px-6 py-4">
                                <div class="relative group">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                                         class="h-14 w-14 rounded-xl object-cover border border-white/20 shadow-md group-hover:scale-110 transition" />
                                </div>
                            </td>

                            <!-- PRODUCT -->
                            <td class="px-6 py-4">
                                <div class="font-semibold text-white">
                                    @item.Name
                                </div>
                                <div class="text-xs text-gray-400">
                                    @item.Category
                                </div>
                            </td>

                            <!-- PRICE -->
                            <td class="px-6 py-4 font-semibold text-green-400">
                                @if (item.PriceType?.ToLower() == "normal")
                                {
                                    if (hasVariants)
                                    {
                                        <span>
                                            ₹ @minPrice.ToString("N0")
                                            @if (maxPrice > minPrice)
                                            {
                                                <span class="text-gray-300"> - ₹ @maxPrice.ToString("N0")</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-500">No variants</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-red-400">Ask Price</span>
                                }
                        </td>

                        <!-- VARIANTS -->
                        <td class="px-6 py-4">
                            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-xs font-semibold">
                                @(item.Variants?.Count ?? 0)
                            </span>
                        </td>

                        <!-- STOCK -->
                        <td class="px-6 py-4 text-gray-300">
                            @totalStock units
                        </td>

                        <!-- GST -->
                        <td class="px-6 py-4 text-gray-300">
                            @item.GSTPercentage %
                        </td>

                        <!-- STATUS -->
                        <td class="px-6 py-4">
                            <span class="px-3 py-1 rounded-full text-xs font-semibold
                                    @(item.Status == "Active"
                                                                          ? "bg-green-500/20 text-green-300"
                                                                          : "bg-red-500/20 text-red-300")">
                                @item.Status
                            </span>
                        </td>

                            <!-- ACTIONS -->
                            <td class="px-6 py-4 text-center">
                                <div class="flex justify-center gap-3">

                                    <a asp-action="ProductEdit"
                                       asp-route-id="@item.Id"
                                       class="px-3 py-1 bg-yellow-400/80 text-black rounded-lg hover:scale-105 transition text-xs font-semibold">
                                        Edit
                                    </a>

                                    <form asp-action="Delete" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="px-3 py-1 bg-red-500/80 text-white rounded-lg hover:scale-105 transition text-xs font-semibold">
                                            Delete
                                        </button>
                                    </form>

                                </div>
                            </td>

                        </tr>
                                        }

                </tbody>
            </table>
        </div>
    </div>
</div>