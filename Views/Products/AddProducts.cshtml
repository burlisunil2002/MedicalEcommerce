@model VivekMedicalProducts.Models.ProductModel

@{
    Layout = null;
}

<head>
    <script src="https://cdn.tailwindcss.com"></script>
</head>


<div class="min-h-screen bg-gradient-to-br from-slate-900 via-indigo-900 to-slate-800 py-10 px-4 text-white">

    
    <div class="max-w-6xl mx-auto bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl shadow-2xl p-8">

        <h2 class="text-3xl font-bold mb-6">Add Medical Product</h2>
        <a asp-action="ProductManagement" class="px-4 py-2 bg-white/10 rounded-lg hover:bg-white/20">← Back</a>

        <form asp-action="AddProducts" method="post" enctype="multipart/form-data" class="space-y-8">

            @Html.AntiForgeryToken()

            <!-- ================= BASIC ================= -->
            <div class="grid md:grid-cols-2 gap-6">

                <div>
                    <label>Product Name</label>
                    <input asp-for="Name" class="input" />
                </div>

                <div>
                    <label>Brand Name</label>
                    <input asp-for="Brand" class="input" />
                </div>

                <div>
                    <label>Category</label>
                    <select asp-for="Category" class="input text-black">
                        <option value="">-- Select Category --</option>
                        <option>Mother & Child Care</option>
                        <option>Radiology</option>
                        <option>Critical Care Equipment</option>
                        <option>Lab & Diagnostics</option>
                        <option>Consumables & Disposables</option>
                        <option>Thermal Camera</option>
                        <option>Medicine Vending Machine</option>
                        <option>Surgical Instruments</option>
                        <option>Hospital Furniture</option>
                        <option>iLAB</option>
                        <option>Safe Zone Container</option>
                        <option>Oxy Wheel</option>
                        <option>Water Recycling System</option>
                        <option>Portable Ventilators</option>
                        <option>Anesthesia Machine</option>
                        <option>Point of Care Devices</option>
                        <option>Prosthesis</option>
                        <option>Instruments</option>
                        <option>Uroflowrometry</option>
                        <option>Microbiology</option>
                    </select>
                </div>

                <div>
                    <label>GST (%)</label>
                    <input asp-for="GSTPercentage" class="input" />
                </div>

                <div>
                    <label>HSN Code</label>
                    <input asp-for="HSNCode" class="input" />
                </div>

                <div>
                    <label>Price Type</label>
                    <select asp-for="PriceType" class="input text-black">
                        <option value="Normal">Normal</option>
                        <option value="AskForPrice">Ask For Price</option>
                    </select>
                </div>

            </div>

            <!-- ================= VARIANTS ================= -->
            <div>
                <h3 class="text-xl font-semibold mb-4">Product Variants</h3>

                <div id="variantContainer" class="space-y-4">

                    <div class="variant-block bg-white/5 p-4 rounded-xl">

                        <div class="grid md:grid-cols-6 gap-3">

                            <input name="Variants[0].Model" placeholder="Model" class="input" />
                            <input name="Variants[0].Size" placeholder="Size" class="input" />

                            <select name="Variants[0].Unit" class="input text-black">
                                <option value="">Unit</option>
                                <option value="ml">ml</option>
                                <option value="mg">mg</option>
                                <option value="cm">cm</option>
                                <option value="piece">piece</option>
                            </select>

                            <input name="Variants[0].PackSize" placeholder="Pack Size" class="input" />
                            <input name="Variants[0].MinQuantity" placeholder="Min Qty" class="input" />
                            <input name="Variants[0].MaxQuantity" placeholder="Max Qty" class="input" />
                            <input name="Variants[0].StepQuantity" placeholder="Step Qty" class="input" />
                            <input name="Variants[0].Price" placeholder="Price" class="input" />
                            <input name="Variants[0].StockQuantity" placeholder="Stock" class="input" />

                            <!-- 🔥 VARIANT IMAGE -->
                            <input type="file" name="Variants[0].ImageFile" class="input" />
                        </div>

                        <!-- 🔥 VARIANT SPECIFICATIONS -->
                        <div id="spec-0" class="mt-3">

                            <div class="grid md:grid-cols-2 gap-3">
                                <input name="Variants[0].Specifications[0].Key" placeholder="Specification" class="input" />
                                <input name="Variants[0].Specifications[0].Value" placeholder="Value" class="input" />
                            </div>

                        </div>

                        <button type="button" onclick="addSpec(0)" class="btn mt-2">
                            + Add Specification
                        </button>

                    </div>

                </div>

                <button type="button" onclick="addVariant()" class="btn mt-3">
                    + Add Variant
                </button>
            </div>

            <!-- ================= DESCRIPTION ================= -->
            <div>
                <label>Description</label>
                <textarea asp-for="Description" class="input"></textarea>
            </div>

            <!-- ================= MEDICAL ================= -->
            <div class="grid md:grid-cols-2 gap-6">

                <div>
                    <label>Batch Number</label>
                    <input asp-for="BatchNumber" class="input" />
                </div>

                <div>
                    <label>Expiry Date</label>
                    <input asp-for="ExpiryDate" type="date" class="input" />
                </div>

            </div>

            <!-- ================= SHIPPING ================= -->
            <div class="grid md:grid-cols-2 gap-6">

                <div>
                    <label>Weight (kg)</label>
                    <input asp-for="Weight" class="input" />
                </div>

                <div class="flex items-center gap-2">
                    <input asp-for="IsFragile" type="checkbox" />
                    <span>Fragile Product</span>
                </div>

            </div>

            <!-- ================= DEALS ================= -->
            <div class="grid md:grid-cols-2 gap-6">

                <div class="flex items-center gap-2">
                    <input asp-for="IsHotDeal" type="checkbox" />
                    <span>Hot Deal 🔥</span>
                </div>

                <div>
                    <label>Discount %</label>
                    <input asp-for="DiscountPercentage" class="input" />
                </div>

                <div>
                    <label>Deal End Date</label>
                    <input asp-for="DealEndDate" type="datetime-local" class="input" />
                </div>

            </div>

            <!-- ================= FILES ================= -->
            <div class="grid md:grid-cols-2 gap-6">

                <div>
                    <label>Product Image</label>
                    <input type="file" name="imageFile" class="input" />
                </div>

                <div>
                    <label>Quotation File</label>
                    <input type="file" name="quotationFile" class="input" />
                </div>

            </div>

            <!-- ================= SUBMIT ================= -->
            <div class="text-right">
                <button type="submit" class="btn">
                    Save Product
                </button>
            </div>

        </form>
    </div>
    

</div>

<script>
            let vIndex = 1;

    function addVariant() {

        let html = `
        <div class="variant-block bg-white/5 p-4 rounded-xl mt-3">

            <!-- 🔥 REQUIRED FOR MODEL BINDING -->
            <input type="hidden" name="Variants.Index" value="${vIndex}" />

            <div class="grid md:grid-cols-6 gap-3">

                <input name="Variants[${vIndex}].Model" class="input" />
                <input name="Variants[${vIndex}].Size" class="input" />

                <select name="Variants[${vIndex}].Unit" class="input text-black">
                    <option value="">Unit</option>
                    <option value="ml">ml</option>
                    <option value="mg">mg</option>
                    <option value="cm">cm</option>
                    <option value="piece">piece</option>
                </select>

                <input name="Variants[${vIndex}].PackSize" class="input" />
                <input name="Variants[${vIndex}].MinQuantity" class="input" />
                <input name="Variants[${vIndex}].MaxQuantity" class="input" />
                <input name="Variants[${vIndex}].StepQuantity" class="input" />
                <input name="Variants[${vIndex}].Price" class="input" />
                <input name="Variants[${vIndex}].StockQuantity" class="input" />
                <input type="file" name="Variants[${vIndex}].ImageFile" class="input" />

            </div>

            <div id="spec-${vIndex}" class="mt-3"></div>

            <button onclick="addSpec(${vIndex})" type="button" class="btn mt-2">
                + Add Spec
            </button>

        </div>`;

        document.getElementById("variantContainer").insertAdjacentHTML('beforeend', html);
        vIndex++;
    }

    function addSpec(vIdx) {

        let c = document.getElementById(`spec-${vIdx}`);
        let i = c.children.length;

        let html = `
        <div class="grid md:grid-cols-2 gap-3 mt-2">
            <input name="Variants[${vIdx}].Specifications[${i}].Key" class="input"/>
            <input name="Variants[${vIdx}].Specifications[${i}].Value" class="input"/>
        </div>`;

        c.insertAdjacentHTML('beforeend', html);
    }
</script>

<style>
    .input {
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
    }

    .btn {
        padding: 10px 20px;
        background: linear-gradient(to right, #6366f1, #a855f7);
        border-radius: 10px;
    }
</style>


